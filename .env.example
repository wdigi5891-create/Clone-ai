# ─────────────── AI VIDEO CLONER — configuration ───────────────
# Copier ce fichier en .env (à la racine du dépôt). Ne jamais committer .env.

# --- Application
APP_ENV=development                      # production : SECRET_KEY obligatoire
SECRET_KEY=change-me-in-production       # python -c "import secrets; print(secrets.token_urlsafe(48))"
CORS_ORIGINS=http://localhost:3000
PUBLIC_API_URL=http://localhost:8000     # URL publique de l'API (liens signés des fichiers)

# --- Base de données / file de tâches
DATABASE_URL=postgresql://videocloner:videocloner@localhost:5432/videocloner
REDIS_URL=redis://localhost:6379/0
TASK_BACKEND=celery                      # celery (production) | inline (thread local, sans Redis)

# --- Stockage
STORAGE_BACKEND=local                    # local | s3
# STORAGE_LOCAL_DIR=./storage/data
# TEMP_DIR=./storage/tmp
TEMP_TTL_HOURS=6                         # suppression des fichiers temporaires
SOURCE_RETENTION_HOURS=0                 # 0 = conserver la vidéo source ; N = suppression après N heures
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT_URL=                         # ex. MinIO / Cloudflare R2 ; vide pour AWS
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Limites d'import
MAX_UPLOAD_MB=500
MAX_DURATION_SECONDS=600
MAX_SCENES=60
URL_IMPORT_ALLOWED_HOSTS=                # liste d'hôtes séparés par des virgules ; vide = tout hôte public

# --- Fournisseurs IA (interchangeables)
VISION_PROVIDER=anthropic                # anthropic | openai | gemini
LLM_PROVIDER=anthropic                   # anthropic | openai | gemini
TRANSCRIPTION_PROVIDER=openai            # openai | gemini | faster_whisper | none
GEMINI_API_KEY=                          # clé gratuite : https://aistudio.google.com/apikey (mettre les 3 fournisseurs sur gemini)
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TRANSCRIPTION_MODEL=              # vide = même modèle
ANTHROPIC_API_KEY=                       # requis si un fournisseur = anthropic
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium                  # low | medium | high | xhigh | max
ANTHROPIC_REFUSAL_FALLBACKS=true         # repli automatique côté serveur en cas de refus
OPENAI_API_KEY=                          # requis si un fournisseur = openai (dont la transcription Whisper)
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o
OPENAI_TRANSCRIPTION_MODEL=whisper-1
FASTER_WHISPER_MODEL=small               # transcription locale (pip install faster-whisper)
ANALYSIS_LANGUAGE=fr                     # langue des fiches et du storyboard
AI_CONCURRENCY=3                         # scènes analysées en parallèle

# --- Frontend (à placer dans frontend/.env.local)
# NEXT_PUBLIC_API_URL=http://localhost:8000
